# Copy to .env.local and fill in. .env.local is ignored by git; this file is the
# committed template and must only ever hold empty placeholders.

# Where Projects data comes from: leave empty (or "mock") for the built-in
# fixture roster, or "supabase" to read the Postgres projects table.
PROJECTS_DATA_SOURCE=

# Supabase — server only. Required when PROJECTS_DATA_SOURCE=supabase.
# Never give these a NEXT_PUBLIC_ prefix: that would ship them to the browser.
#
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# The project's secret key (sb_secret_...) or legacy service_role key.
# It bypasses row level security. Do not use the publishable or anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in (Supabase Auth). Required: without these the application stays
# closed and every page sends to the sign-in page.
#
# The project's publishable key (sb_publishable_...) or legacy anon key. Safe
# for a browser by design, but only the server uses it, so it has no
# NEXT_PUBLIC_ prefix. Never put the secret or service_role key here.
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated email addresses allowed to use the application. An account
# that signs in but is not on this list is signed straight back out.
NEXRA_OPERATOR_EMAILS=
