# Copy to .env.local and fill in. .env.local is ignored by git; this file is the
# committed template and must only ever hold empty placeholders.

# Where Projects data comes from: leave empty (or "mock") for the built-in
# fixture roster, or "supabase" to read the Postgres projects table.
PROJECTS_DATA_SOURCE=

# Supabase — server only. Required when PROJECTS_DATA_SOURCE=supabase.
# Never give these a NEXT_PUBLIC_ prefix: that would ship them to the browser.
#
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# The project's secret key (sb_secret_...) or legacy service_role key.
# It bypasses row level security. Do not use the publishable or anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in (Supabase Auth). Required: without these the application stays
# closed and every page sends to the sign-in page.
#
# The project's publishable key (sb_publishable_...) or legacy anon key. Safe
# for a browser by design, but only the server uses it, so it has no
# NEXT_PUBLIC_ prefix. Never put the secret or service_role key here.
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated email addresses allowed to use the application. An account
# that signs in but is not on this list is signed straight back out.
NEXRA_OPERATOR_EMAILS=

# Google Search Console — server only, optional. Leave all three empty and every
# project reads as "not connected"; set all three to connect. Never give these a
# NEXT_PUBLIC_ prefix.
#
# The service account's address, e.g. name@project-id.iam.gserviceaccount.com.
# It must be added as a user on each Search Console property it reads.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The private_key field of the service account's JSON key, on one line with
# literal \n between lines. A secret.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Which property each project reports on: comma-separated project-id=property
# pairs, where a property is sc-domain:example.com or https://www.example.com/.
SEARCH_CONSOLE_PROPERTIES=

# Scheduled worker — server only. Required in production for stale-run
# recovery and queue processing (/api/worker/*). A random string of at least 32
# characters, e.g. `openssl rand -hex 32`. Vercel Cron sends it as
# "Authorization: Bearer <value>". Unset, every worker request is refused.
CRON_SECRET=

# Agent executor: leave empty (or "mock") for simulated output, or "ai" to
# answer agent tasks with a language model. "ai" spends money on every attempt.
NEXRA_AGENT_EXECUTOR=
# AI provider — server only, needed only when NEXRA_AGENT_EXECUTOR=ai.
# With "ai" selected and these incomplete, attempts fail with
# provider-not-configured rather than falling back to simulated output.
NEXRA_AI_PROVIDER=
# A secret. Never give it a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=
# Optional model id; defaults to claude-opus-5.
NEXRA_AI_MODEL=

# Crawling — server only. Off unless both of the first two are set: the flag
# says this deployment may fetch client websites at all, and the allow-list
# says which hosts. Neither is a secret, and neither may carry a NEXT_PUBLIC_
# prefix: an allow-list is server policy and has no business in a browser.
#
# Leave CRAWL_ENABLED empty and nothing here makes an outbound request.
# Connections are pinned to an approved address, so a host cannot redirect or
# re-resolve its way onto an internal one; list only hosts you mean to crawl.
CRAWL_ENABLED=
# Comma-separated hostnames, matched exactly. A parent domain does not
# authorise its subdomains.
CRAWL_ALLOWED_HOSTS=
# Optional. How the crawler identifies itself; defaults to a NexraBot token
# with a contact URL. Never set this to a browser's user agent string.
CRAWL_USER_AGENT=
# Optional limits on one crawl. Each is a plain whole number; a value that is
# out of range or will not parse refuses the whole crawl configuration rather
# than being clamped to something workable, so a typo cannot quietly become a
# crawl size nobody chose. Leave any of them empty to keep the default.
#
# Pages fetched, 1-500. Defaults to 50.
CRAWL_MAX_PAGES=
# Link depth from the start URL, 0-10. Defaults to 3. Depth 0 is a real
# setting: fetch the start URL and follow nothing.
CRAWL_MAX_DEPTH=
# Requests in flight at once, 1-5. Defaults to 3. The ceiling is low on
# purpose: this is what one client's server is asked to absorb.
CRAWL_CONCURRENCY=

# DataForSEO — server only, optional (F0 keyword snapshot). Leave both
# credentials empty and the provider reads as "not set up"; set both to
# connect. They are secrets: never give any of these a NEXT_PUBLIC_ prefix.
# In production they are Vercel Sensitive variables, Production only.
#
# The account's API login and API password (HTTP Basic auth).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Which API the server calls: leave empty for the free sandbox (dummy data,
# recorded as such); set exactly "live" to call the paid API. Any other value
# is the sandbox. A change takes effect on the next deployment.
DATAFORSEO_MODE=
# The daily spending cap for live calls, in US dollars, enforced by the
# database. Leave empty for the default, 1.00. Above 5.00, negative or
# unparsable refuses every run rather than falling back.
DATAFORSEO_DAILY_CAP_USD=
